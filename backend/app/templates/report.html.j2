<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Audit Report {{ audit_run_id }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 24px; color: #1f2937; }
    h1, h2 { color: #0f172a; }
    .card { border: 1px solid #d1d5db; padding: 12px; margin-bottom: 12px; border-radius: 6px; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; background: #e5e7eb; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #d1d5db; padding: 8px; font-size: 12px; text-align: left; }
    .small { font-size: 12px; color: #4b5563; }
  </style>
</head>
<body>
  <h1>Compliance Audit Report</h1>
  <p class="small">AuditRun: {{ audit_run_id }} | Project: {{ project_name }} | Organization: {{ org_name }}</p>

  <div class="card">
    <h2>Executive Summary</h2>
    <p>Risk score: <strong>{{ risk_score }}</strong> ({{ risk_level }})</p>
    <p>Total controls: {{ total_controls }} | Findings: {{ findings|length }} | Remediation tasks: {{ remediation_tasks|length }}</p>
  </div>

  <div class="card">
    <h2>SoA / DoA Placeholders</h2>
    <p>[PLACEHOLDER] Statement of Applicability content to be completed by compliance team.</p>
    <p>[PLACEHOLDER] Declaration of Applicability content to be completed by compliance team.</p>
  </div>

  <div class="card">
    <h2>Findings</h2>
    <table>
      <thead>
        <tr><th>Control</th><th>Severity</th><th>Result</th><th>Confidence</th><th>Notes</th></tr>
      </thead>
      <tbody>
      {% for finding in findings %}
        <tr>
          <td>{{ finding.control_id }}</td>
          <td>{{ finding.severity }}</td>
          <td>{{ finding.result }}</td>
          <td>{{ finding.confidence }}</td>
          <td>{{ finding.notes }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Remediation Plan</h2>
    <table>
      <thead>
        <tr><th>Task</th><th>Status</th><th>Description</th></tr>
      </thead>
      <tbody>
      {% for task in remediation_tasks %}
        <tr>
          <td>{{ task.title }}</td>
          <td>{{ task.status }}</td>
          <td>{{ task.description }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</body>
</html>
