{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(audity_http_requests_total[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "API Latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(audity_http_request_latency_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Rate Limit Hits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(audity_rate_limit_hits_total[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Uploads Quarantined",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(audity_upload_quarantined_total[1h])) by (org_id)",
          "legendFormat": "{{org_id}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["audity"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Audity Enterprise Overview",
  "version": 1
